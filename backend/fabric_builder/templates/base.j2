!!! Day-0 / Base Configuration
!! Generated by Classic Fabric Visualiser - Fabric Builder

hostname {{ device.hostname }}

!! Feature Set
feature nxapi
feature bash-shell
feature scp-server
feature sftp-server
feature tacacs+
feature scheduler
feature fabric forwarding
feature interface-vlan
feature vn-segment-vlan-based
feature lacp
feature vpc
feature lldp
feature bfd
feature nv overlay
feature bgp
{% if global_config.underlay_protocol == "ospf" %}
feature ospf
{% endif %}
nv overlay evpn

!! Spanning Tree
spanning-tree mode mst
spanning-tree mst 0-1 priority 4096
{% if is_spine %}
spanning-tree mst 0-1 priority 4096
{% elif is_leaf %}
spanning-tree mst 0-1 priority 8192
{% endif %}

!! Boot Configuration
{% if device.model %}
!! Platform: {{ device.model }}
{% endif %}
{% if global_config.nxos_version %}
!! Target NX-OS Version: {{ global_config.nxos_version }}
{% endif %}

!! System Settings
system jumbomtu 9216
copp profile strict
hardware access-list tcam region racl 512
hardware access-list tcam region arp-ether 256 double-wide

!! Fabric Forwarding
fabric forwarding anycast-gateway-mac {{ global_config.anycast_gw_mac }}

